# CONFIGURACIÓN GENERAL
PORT=8080
# BASE DE DATOS DE PRODUCCIÓN: Usa el nombre lógico de base de datos 'proyecto' en la URI.
# BASE DE DATOS DE TESTS: Los tests en perfil 'test' se conectan automáticamente a 'isivi_test'.
# ¡ADVERTENCIA! NO EJECUTAR TESTS CONTRA LA BASE DE PRODUCCIÓN 'proyecto' PARA EVITAR LA PÉRDIDA DE DATOS REALES.
MONGODB_URI=mongodb+srv://.../proyecto
ADMIN_INITIAL_PASSWORD=cambiame123

# SEGURIDAD - JWT
JWT_SECRET=tu_clave_secreta_super_larga_y_segura
JWT_EXPIRATION_MS=86400000

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# WOMPI (PASARELA DE PAGO)
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=prod_integrity_...
WOMPI_EVENTS_SECRET=prod_events_...
WOMPI_REDIRECT_URL=https://isivi-app.onrender.com/#pago
WOMPI_SANDBOX=true

# EMAIL TRANSACCIONAL (BREVO)
BREVO_API_KEY=xkeysib-...
MAIL_FROM=contacto@isivi.com
MAIL_ENABLED=true

# WHATSAPP (OPCIONAL)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
